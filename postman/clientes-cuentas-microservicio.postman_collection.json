    {
      "name": "3. Cuentas",
      "description": "Operaciones de escritura/lectura sobre cuentas. Algunas guardan `createdAccountApiId` para reutilizarlo después.",
      "item": [
        {
          "name": "POST /cuentas - cliente existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.apiId).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('createdAccountApiId', data.apiId);",
                  "pm.test('apiId guardado', function () { pm.expect(pm.collectionVariables.get('createdAccountApiId')).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dniCliente\": \"{{existingCustomerDni}}\",\n  \"codTipoCuenta\": \"JR\",\n  \"total\": 500.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cuentas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cuentas"
              ]
            },
            "description": "Crea una nueva cuenta asociada al cliente 11111111A y guarda el apiId devuelto."
          }
        },
        {
          "name": "POST /cuentas - cliente no existente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const randomDni = `${Math.floor(10000000 + Math.random() * 89999999)}Z`;",
                  "pm.collectionVariables.set('newCustomerDni', randomDni);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.apiId).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('createdAccountApiId', data.apiId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dniCliente\": \"{{newCustomerDni}}\",\n  \"codTipoCuenta\": \"NRML\",\n  \"total\": 200.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cuentas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cuentas"
              ]
            },
            "description": "Genera un DNI aleatorio válido, crea cliente y cuenta, y guarda el `createdAccountApiId`."
          }
        },
        {
          "name": "PATCH /cuentas/{apiIdCuenta}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
