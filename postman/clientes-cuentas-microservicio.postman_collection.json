                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cuentas/{{createdAccountApiId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cuentas",
                "{{createdAccountApiId}}"
              ]
            },
            "description": "Requiere haber ejecutado previamente uno de los POST de creación para poblar `createdAccountApiId`."
          }
        },
        {
          "name": "GET /cuentas/{apiIdCuenta}",
          "event": [
