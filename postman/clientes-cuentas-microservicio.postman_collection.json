  "item": [
    {
      "name": "1. Autenticación",
      "description": "Obtención de tokens para los usuarios reales incluidos en el realm exportado de Keycloak.",
      "item": [
        {
          "name": "Obtener token JWT - adminUser/admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.access_token).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', data.access_token);",
                  "pm.test('Token admin almacenado', function () { pm.expect(pm.collectionVariables.get('accessToken')).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{adminUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Obtiene y guarda en la variable de colección `accessToken` el JWT del usuario administrador."
          }
        },
        {
          "name": "Obtener token JWT - readUser/read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.expect(data.access_token).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('readAccessToken', data.access_token);",
                  "pm.test('Token read almacenado', function () { pm.expect(pm.collectionVariables.get('readAccessToken')).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{readUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{readPassword}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Obtiene y guarda en la variable de colección `readAccessToken` el JWT del usuario de solo lectura."
          }
        }
      ]
